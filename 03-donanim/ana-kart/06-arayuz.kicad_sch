			)
			(justify left bottom)
		)
		(uuid "89ddfcdf-6f20-41f3-9f40-0699ed25c501")
	)
	(text "   Direncler MCU tarafindaki global net ile LCD nin yerel pini ARASINDA"
		(exclude_from_sim no)
		(at 13.97 339.09 0)
		(effects
			(font
				(size 1.4 1.4)
			)
			(justify left bottom)
		)
		(uuid "9b7ab39b-7b60-4f6a-b417-66e7b4d9253a")
	)
	(text "   konnektorunun hemen yanina konacak."
