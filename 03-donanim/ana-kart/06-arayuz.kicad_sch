		(at 13.97 346.71 0)
		(effects
			(font
				(size 1.4 1.4)
			)
			(justify left bottom)
		)
		(uuid "9e706143-7fa5-4909-87cc-2a511cc87084")
	)
	(text "   kesmenin nedeni sonradan kayittan okunabilsin."
